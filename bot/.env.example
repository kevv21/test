# Copiá este archivo como ".env" y completá tus datos de Meta / WhatsApp Cloud API

# Token de acceso (temporal para pruebas o permanente en producción)
WA_TOKEN=tu_token_de_meta

# Phone Number ID (lo ves en el panel de WhatsApp > API Setup)
WA_PHONE_ID=tu_phone_number_id

# Palabra de verificación del webhook (la elegís vos, debe coincidir en Meta)
WA_VERIFY_TOKEN=rockmunchies123

# (Opcional) App Secret para validar la firma de los webhooks
WA_APP_SECRET=

# URL pública de tu sitio web ya publicado
SITE_URL=https://TU-WEB.com

# Puerto local
PORT=3000
